# EO-TACTICA local environment.
# Copy to `.env` at the repo root. The agents service auto-loads this file.

NODE_ENV=development

# Backend (apps/backend) listens on PORT, defaults shown.
BACKEND_PORT=3001
AGENTS_PORT=3002
HOST=0.0.0.0

# Postgres + Redis (started by `npm run compose:dev:up`).
DATABASE_URL=postgres://eo:eo_dev_pw@localhost:5432/eo_tactica
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:8080

# Bootstrap super-admin (created idempotently on backend boot).
SUPER_ADMIN_EMAIL=admin@eo-tactica.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_TENANT_SLUG=tactica

# JWT settings.
JWT_TTL_SECONDS=86400

# Anthropic SDK — lives ONLY on the agents service. Never embed in frontend.
ANTHROPIC_API_KEY=
AGENT_MODEL_DEFAULT=claude-sonnet-4-6
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=2048
