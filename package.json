{
  "name": "eo-tactica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@eo-tactica/frontend",
    "dev:frontend": "npm run dev --workspace=@eo-tactica/frontend",
    "dev:backend": "npm run dev --workspace=@eo-tactica/backend",
    "dev:agents": "npm run dev --workspace=@eo-tactica/agents",
    "dev:ingest": "npm run dev --workspace=@eo-tactica/ingest",
    "dev:all": "npm-run-all --parallel dev:backend dev:agents dev:ingest dev:frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=@eo-tactica/backend",
    "compose:dev:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "compose:dev:down": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
